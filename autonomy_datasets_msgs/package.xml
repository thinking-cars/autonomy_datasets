<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>autonomy_datasets_msgs</name>
  <version>1.3.0</version>
  <description>Message definitions for dataset meta information that has no representation in perception_msgs</description>

  <maintainer email="vankempen@thinking-cars.de">Raphael van Kempen</maintainer>
  <author email="vankempen@thinking-cars.de">Raphael van Kempen</author>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
